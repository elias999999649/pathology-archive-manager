<div class="mb-2 grid gap-2 sm:grid-cols-12" data-condition><select name="archive_rule[conditions][groups][<%= group_index %>][conditions][<%= condition_index %>][field]" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-3 dark:border-slate-700 dark:bg-slate-950"><% ArchiveRule::FIELDS.each do |field| %><option value="<%= field %>" <%= 'selected' if condition['field'].to_s == field %>><%= field.humanize %></option><% end %></select><select name="archive_rule[conditions][groups][<%= group_index %>][conditions][<%= condition_index %>][operator]" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-3 dark:border-slate-700 dark:bg-slate-950"><% ArchiveRule::OPERATORS.each do |operator| %><option value="<%= operator %>" <%= 'selected' if condition['operator'].to_s == operator %>><%= operator.humanize %></option><% end %></select><input name="archive_rule[conditions][groups][<%= group_index %>][conditions][<%= condition_index %>][value]" value="<%= condition['value'] %>" placeholder="Value" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-2 dark:border-slate-700 dark:bg-slate-950"><input name="archive_rule[conditions][groups][<%= group_index %>][conditions][<%= condition_index %>][value_to]" value="<%= condition['value_to'] %>" placeholder="To (between)" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-2 dark:border-slate-700 dark:bg-slate-950"><input name="archive_rule[conditions][groups][<%= group_index %>][conditions][<%= condition_index %>][path]" value="<%= condition['path'] %>" placeholder="Metadata path" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-1 dark:border-slate-700 dark:bg-slate-950"><button type="button" data-action="rule-builder#removeCondition" class="rounded-lg px-2 text-sm font-medium text-rose-600 sm:col-span-1" aria-label="Remove condition">Remove</button></div>
