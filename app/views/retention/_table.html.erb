<section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800"><h2 class="font-semibold"><%= title %></h2></div><% if slides.any? %><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-800"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-950/50 dark:text-slate-400"><tr><th class="px-4 py-3">Slide ID</th><th class="px-4 py-3">Case ID</th><th class="px-4 py-3">Expiration</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Rule responsible</th><th class="px-4 py-3">Action</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800"><% slides.each do |slide| %><tr><td class="px-4 py-4 font-medium"><%= link_to slide.slide_uid, slide_path(slide), class: "text-indigo-600 hover:underline dark:text-indigo-400" %></td><td class="px-4 py-4"><%= slide.case_id %></td><td class="whitespace-nowrap px-4 py-4"><%= slide.retention_expires_at&.to_fs(:long) || "Forever" %></td><td class="px-4 py-4"><span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300"><%= slide.retention_status.humanize %></span></td><td class="px-4 py-4"><%= slide.retention_rule&.name || "Manual / policy-based" %></td><td class="px-4 py-4"><%= link_to "View slide", slide_path(slide), class: "font-medium text-indigo-600 hover:underline dark:text-indigo-400" %></td></tr><% end %></tbody></table></div><% else %><div class="p-8 text-sm text-slate-500 dark:text-slate-400"><%= empty_message %></div><% end %></section>
