<% content_for :page_title, "Archive Rules" %>
<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-sm text-slate-600 dark:text-slate-400">Configure deterministic archive decisions without changing application code.</p></div><%= link_to "Create rule", new_settings_archive_rule_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %></div>
<% if @rules.any? %>
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900"><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-800"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-950/50 dark:text-slate-400"><tr><th class="px-4 py-3">Rule</th><th class="px-4 py-3">Priority</th><th class="px-4 py-3">Version</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Updated by</th><th class="px-4 py-3">Actions</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800"><% @rules.each do |rule| %><tr><td class="px-4 py-4"><div class="font-medium"><%= rule.name %></div><div class="mt-1 max-w-md truncate text-xs text-slate-500 dark:text-slate-400"><%= rule.description.presence || "No description" %></div></td><td class="px-4 py-4 font-semibold"><%= rule.priority %></td><td class="px-4 py-4">v<%= rule.version %></td><td class="px-4 py-4"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= rule.enabled? ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400' %>"><%= rule.enabled? ? "Enabled" : "Disabled" %></span></td><td class="px-4 py-4 text-slate-600 dark:text-slate-400"><%= rule.updated_by.email %></td><td class="px-4 py-4"><div class="flex flex-wrap gap-3"><%= link_to "Edit", edit_settings_archive_rule_path(rule), class: "font-medium text-indigo-600 hover:underline dark:text-indigo-400" %><%= button_to "Duplicate", duplicate_settings_archive_rule_path(rule), method: :post, class: "font-medium text-slate-600 hover:underline dark:text-slate-300" %><%= button_to "Delete", settings_archive_rule_path(rule), method: :delete, data: { turbo_confirm: "Delete this archive rule?" }, class: "font-medium text-rose-600 hover:underline dark:text-rose-300" %></div></td></tr><% end %></tbody></table></div></div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900"><h2 class="font-semibold">No archive rules yet</h2><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Create a rule to define how matching slides should be handled.</p><%= link_to "Create your first rule", new_settings_archive_rule_path, class: "mt-5 inline-block font-medium text-indigo-600 hover:underline dark:text-indigo-400" %></div>
<% end %>
