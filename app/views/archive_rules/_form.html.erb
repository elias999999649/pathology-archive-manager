<% fields = ArchiveRule::FIELDS %>
<% operators = ArchiveRule::OPERATORS %>
<%= form_with model: rule, url: rule.persisted? ? settings_archive_rule_path(rule) : settings_archive_rules_path, data: { controller: "rule-builder" }, class: "space-y-6" do |form| %>
  <% if rule.errors.any? %><div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300"><p class="font-semibold">Please correct the following:</p><ul class="mt-2 list-disc pl-5"><% rule.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :name, class: "mb-1 block text-sm font-medium" %><%= form.text_field :name, required: true, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><div><%= form.label :priority, class: "mb-1 block text-sm font-medium" %><%= form.number_field :priority, min: 0, required: true, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><div class="sm:col-span-2"><%= form.label :description, class: "mb-1 block text-sm font-medium" %><%= form.text_area :description, rows: 2, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><label class="flex items-center gap-3 text-sm font-medium"><%= form.check_box :enabled, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Enabled</label></div>
  <div data-rule-builder-target="message" class="hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-700 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300"></div>
  <section class="rounded-xl border border-slate-200 p-4 dark:border-slate-800"><div class="mb-4 flex flex-wrap items-center justify-between gap-3"><div><div class="mb-1 text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">IF</div><h2 class="font-semibold">Slide matches these conditions</h2><p class="text-xs text-slate-500 dark:text-slate-400">Choose how conditions inside a group and groups themselves are combined.</p></div><button type="button" data-action="rule-builder#addGroup" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-indigo-600 dark:border-slate-700">Add condition group</button></div><div class="mb-4 flex items-center gap-2 text-sm"><span>Groups match</span><select name="archive_rule[conditions][logic]" class="rounded-lg border border-slate-300 bg-white px-2 py-1 dark:border-slate-700 dark:bg-slate-950"><% %w[and or].each do |logic| %><option value="<%= logic %>" <%= 'selected' if rule.conditions['logic'].to_s == logic %>><%= logic.upcase %></option><% end %></select></div><div data-rule-builder-target="groups"><% rule.conditions.fetch("groups", []).each_with_index do |group, group_index| %><%= render "condition_group", group: group, group_index: group_index %><% end %></div><template data-rule-builder-target="groupTemplate"><%= render "condition_group", group: { "logic" => "and", "conditions" => [{ "field" => "slide_type", "operator" => "equals", "value" => "" }] }, group_index: "GROUP_INDEX" %></template><template data-rule-builder-target="conditionTemplate"><%= render "condition", condition: { "field" => "slide_type", "operator" => "equals", "value" => "" }, group_index: "GROUP_INDEX", condition_index: "CONDITION_INDEX" %></template></section>
  <section class="rounded-xl border border-slate-200 p-4 dark:border-slate-800"><div class="mb-4 flex items-center justify-between"><div><div class="mb-1 text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">THEN</div><h2 class="font-semibold">Apply these actions</h2><p class="text-xs text-slate-500 dark:text-slate-400">Exactly one decision action is required. Add operational actions when needed.</p></div><button type="button" data-action="rule-builder#addAction" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-indigo-600 dark:border-slate-700">Add action</button></div><div data-rule-builder-target="actions"><% rule.actions.each_with_index do |action, action_index| %><%= render "action", action: action, action_index: action_index %><% end %></div><template data-rule-builder-target="actionTemplate"><%= render "action", action: { "type" => "keep" }, action_index: "ACTION_INDEX" %></template></section>
  <% if defined?(@validation_message) && @validation_message %><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300"><%= @validation_message %></div><% end %>
  <div class="flex flex-wrap gap-3"><%= form.submit rule.persisted? ? "Save new version" : "Create rule", data: { turbo_submits_with: "Saving…" }, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %><button type="submit" formaction="<%= validate_settings_archive_rules_path %>" formmethod="post" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium dark:border-slate-700">Validate rule</button><%= link_to "Cancel", settings_archive_rules_path, class: "rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium dark:border-slate-700" %></div>
<% end %>
