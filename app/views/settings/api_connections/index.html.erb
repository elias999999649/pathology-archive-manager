<% content_for :page_title, "API Connections" %>
<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
  <div><p class="text-sm text-slate-600 dark:text-slate-400">Manage external pathology system connections and synchronization.</p></div>
  <%= link_to "Add connection", new_settings_api_connection_path, class: "ui-btn ui-btn-primary" %>
</div>

<% if @api_connections.any? %>
  <div class="ui-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-800">
        <thead class="ui-table"><tr><th>Name</th><th>Authentication</th><th>Status</th><th>Enabled</th><th>Last successful sync</th><th>Last error</th><th>Actions</th></tr></thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% @api_connections.each do |connection| %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-950/50">
              <td class="px-4 py-4"><div class="font-medium"><%= connection.name %></div><div class="mt-1 max-w-xs truncate text-xs text-slate-500 dark:text-slate-400"><%= connection.base_url %></div></td>
              <td class="whitespace-nowrap px-4 py-4"><%= connection.authentication_label %><% if connection.credentials_configured? %><span class="ml-2 text-xs text-slate-500">Credentials set</span><% end %></td>
              <td class="whitespace-nowrap px-4 py-4"><span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300"><%= connection.status.humanize %></span></td>
              <td class="whitespace-nowrap px-4 py-4"><%= connection.enabled? ? "Yes" : "No" %></td>
              <td class="whitespace-nowrap px-4 py-4 text-slate-600 dark:text-slate-400"><%= connection.last_successful_sync_at&.to_fs(:short) || "Never" %></td>
              <td class="max-w-xs truncate px-4 py-4 text-rose-600 dark:text-rose-300"><%= connection.last_error.presence || "—" %></td>
              <td class="whitespace-nowrap px-4 py-4"><div class="flex flex-wrap gap-2"><%= link_to "Edit", edit_settings_api_connection_path(connection), class: "font-medium text-indigo-600 hover:underline dark:text-indigo-400" %><%= button_to "Test", test_settings_api_connection_path(connection), method: :post, class: "font-medium text-slate-600 hover:underline dark:text-slate-300" %><%= button_to "Sync", sync_settings_api_connection_path(connection), method: :post, class: "font-medium text-slate-600 hover:underline dark:text-slate-300" %><%= button_to connection.enabled? ? "Disable" : "Enable", toggle_settings_api_connection_path(connection), method: :patch, class: "font-medium text-slate-600 hover:underline dark:text-slate-300" %><%= button_to "Delete", settings_api_connection_path(connection), method: :delete, data: { turbo_confirm: "Delete this API connection? Existing slides will prevent deletion if they still reference it." }, class: "font-medium text-rose-600 hover:underline dark:text-rose-300" %></div></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="ui-empty"><h2 class="font-semibold">No API connections yet</h2><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Connect an external pathology system to prepare for synchronization.</p><%= link_to "Create your first connection", new_settings_api_connection_path, class: "ui-btn ui-btn-primary mt-5" %></div>
<% end %>
