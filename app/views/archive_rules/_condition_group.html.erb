<div class="mb-4 rounded-lg bg-slate-50 p-3 dark:bg-slate-950/50" data-rule-group data-group-index="<%= group_index %>"><div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div class="flex items-center gap-2"><span class="text-sm font-medium">This group matches</span><select name="archive_rule[conditions][groups][<%= group_index %>][logic]" class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm dark:border-slate-700 dark:bg-slate-950"><% %w[and or].each do |logic| %><option value="<%= logic %>" <%= 'selected' if group['logic'].to_s == logic %>><%= logic.upcase %></option><% end %></select></div><div class="flex gap-3"><button type="button" data-action="rule-builder#addCondition" class="text-xs font-medium text-indigo-600">Add condition</button><button type="button" data-action="rule-builder#removeGroup" class="text-xs font-medium text-rose-600">Remove group</button></div></div><div data-conditions><% group.fetch('conditions', []).each_with_index do |condition, condition_index| %><%= render "condition", condition: condition, group_index: group_index, condition_index: condition_index %><% end %></div></div>
