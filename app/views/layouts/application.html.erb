<!DOCTYPE html>
<html lang="en" data-controller="theme">
  <head>
    <title>Pathology Archive Manager</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-950 antialiased dark:bg-slate-950 dark:text-slate-50">
    <% if user_signed_in? %>
      <div class="flex min-h-screen">
        <%= render "layouts/sidebar" %>
        <main class="min-w-0 flex-1">
          <header class="flex min-h-16 items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-3 sm:px-8 dark:border-slate-800 dark:bg-slate-900">
            <div>
              <p class="ui-kicker">Archive operations</p>
              <h1 class="mt-0.5 text-lg font-semibold tracking-tight"><%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %></h1>
            </div>
            <div class="flex min-w-0 flex-1 items-center justify-end gap-3 sm:gap-5">
              <%= form_with url: slides_path, method: :get, local: true, scope: nil, data: { controller: "global-search" }, class: "relative hidden min-w-0 flex-1 max-w-xl sm:block" do |form| %>
                <%= form.label :q, "Global slide search", class: "sr-only" %>
                <%= form.search_field :q, placeholder: "Search slides…", autocomplete: "off", data: { global_search_target: "input" }, class: "ui-input w-full bg-slate-50 pr-20 dark:bg-slate-950" %>
                <kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-slate-300 px-1.5 py-0.5 text-[10px] text-slate-500 dark:border-slate-700">/</kbd>
              <% end %>
              <%= link_to "Search", slides_path, class: "rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium sm:hidden dark:border-slate-700" %>
              <button type="button" data-action="theme#toggle" class="ui-btn ui-btn-secondary" aria-label="Toggle light and dark mode">Theme</button>
              <span class="hidden text-sm text-slate-600 sm:inline dark:text-slate-300"><%= current_user.email %></span>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "ui-btn bg-slate-900 text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200" %>
            </div>
          </header>
          <section class="mx-auto w-full max-w-[1600px] p-4 sm:p-6 lg:p-8">
            <% flash.each do |type, message| %>
              <div class="mb-6 rounded-lg border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-900 dark:border-indigo-900 dark:bg-indigo-950/40 dark:text-indigo-100"><%= message %></div>
            <% end %>
            <%= yield %>
          </section>
        </main>
      </div>
    <% else %>
      <main class="flex min-h-screen items-center justify-center px-4 py-12">
        <section class="w-full max-w-md">
          <% flash.each do |_type, message| %>
            <div class="mb-6 rounded-lg border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-900 dark:border-indigo-900 dark:bg-indigo-950/40 dark:text-indigo-100"><%= message %></div>
          <% end %>
          <%= yield %>
        </section>
      </main>
    <% end %>
  </body>
</html>
