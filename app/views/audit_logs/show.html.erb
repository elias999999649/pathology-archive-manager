<% content_for :page_title, "Audit Event" %>
<div class="mb-5"><%= link_to "← Back to audit logs", audit_logs_path, class: "text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400" %></div>
<article class="max-w-3xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 class="text-xl font-semibold"><%= @audit_log.event_type.humanize %></h2><p class="mt-1 text-sm text-slate-500"><%= @audit_log.created_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></p></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium dark:bg-slate-800"><%= @audit_log.actor&.email || "System" %></span></div>
  <dl class="mt-6 grid gap-4 sm:grid-cols-2"><div><dt class="text-xs uppercase text-slate-500">Resource</dt><dd class="mt-1 font-medium"><%= @audit_log.auditable_type ? "#{@audit_log.auditable_type} · #{@audit_log.auditable_id}" : "—" %></dd></div><div><dt class="text-xs uppercase text-slate-500">Event ID</dt><dd class="mt-1 break-all font-mono text-xs"><%= @audit_log.id %></dd></div></dl>
  <div class="mt-6"><h3 class="font-semibold">Event details</h3><pre class="mt-3 overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-100"><%= JSON.pretty_generate(@audit_log.metadata) %></pre></div>
</article>
