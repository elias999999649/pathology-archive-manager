<% content_for :page_title, "Manual review" %>
<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-center"><div><%= link_to "← Back to reviews", reviews_path, class: "text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400" %><h2 class="mt-3 text-2xl font-semibold"><%= @slide.slide_uid %></h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Case <%= @slide.case_id %> · <%= @slide.decision.humanize %></p></div><span class="inline-flex w-fit rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300"><%= @slide.status.humanize %></span></div>
<div class="grid gap-6 xl:grid-cols-3">
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm xl:col-span-2 dark:border-slate-800 dark:bg-slate-900"><h3 class="mb-5 font-semibold">Slide metadata</h3><dl class="grid gap-4 sm:grid-cols-2"><% [["Patient ID", @slide.patient_id], ["Barcode", @slide.barcode], ["Slide type", @slide.slide_type], ["Stain", @slide.stain], ["Scanner", @slide.scanner], ["Hospital", @slide.hospital], ["Department", @slide.department], ["Diagnosis", @slide.diagnosis], ["Acquisition date", @slide.acquisition_date&.to_fs(:long)], ["Received", @slide.received_at&.to_fs(:long)], ["Tags", @slide.tags.join(", ")]].each do |label, value| %><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= label %></dt><dd class="mt-1 break-words text-sm"><%= value.presence || "—" %></dd></div><% end %></dl><h3 class="mb-3 mt-6 font-semibold">External metadata</h3><pre class="overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-200"><%= JSON.pretty_generate(@slide.metadata) %></pre></section>
  <aside class="space-y-6"><section class="rounded-xl border border-indigo-200 bg-indigo-50/60 p-6 dark:border-indigo-900 dark:bg-indigo-950/30"><h3 class="mb-4 font-semibold">Why review is needed</h3><% if @latest_evaluation %><p class="text-sm"><%= @latest_evaluation.reason %></p><p class="mt-3 text-xs text-slate-600 dark:text-slate-400">Matched rules: <%= @latest_evaluation.matched_rule_ids.length %></p><% else %><p class="text-sm text-slate-600 dark:text-slate-400">No automatic evaluation details are available.</p><% end %></section>
  <% if @latest_evaluation && @latest_evaluation.details["matched_rules"].present? %><section class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"><h3 class="mb-4 font-semibold">Matching rules</h3><% @latest_evaluation.details["matched_rules"].each do |rule| %><div class="mb-3 text-sm"><p class="font-medium"><%= rule["name"] %></p><% Array(rule["conditions"]).each do |group| %><% Array(group["conditions"]).each do |condition| %><p class="mt-1 text-xs text-slate-600 dark:text-slate-400"><%= condition["reason"] %></p><% end %><% end %></div><% end %></section><% end %></aside>
</div>
<% if @slide.status == "under_review" %><section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"><h3 class="mb-1 font-semibold">Record review decision</h3><p class="mb-5 text-sm text-slate-600 dark:text-slate-400">Choose a safe decision. Delete only schedules the slide for the existing deletion workflow.</p><%= form_with url: decide_review_path(@slide), method: :post, local: true, class: "space-y-5" do |form| %><div><%= form.label :comment, "Comment", class: "mb-1 block text-sm font-medium" %><%= form.text_area :comment, rows: 3, placeholder: "Explain your decision…", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :retention_policy_code, "Retention", class: "mb-1 block text-sm font-medium" %><%= form.select :retention_policy_code, [["No change", "none"]] + RetentionPolicy::PRESETS.map { |code, values| [values.first, code] } + [["Custom days", "custom"]], {}, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><div><%= form.label :custom_days, "Custom days", class: "mb-1 block text-sm font-medium" %><%= form.number_field :custom_days, min: 1, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div></div><div><%= form.label :tags, "Add tags", class: "mb-1 block text-sm font-medium" %><%= form.text_field :tags, placeholder: "Comma-separated tags", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-950" %></div><div class="flex flex-wrap gap-3"><button type="submit" name="decision" value="keep" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500">Keep slide</button><button type="submit" name="decision" value="delete" data-turbo-confirm="Delete this slide? It will only be scheduled for the safe deletion workflow and will not be permanently deleted." class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500">Delete / schedule</button></div><% end %></section><% else %><div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900">This slide has already been reviewed.</div><% end %>
