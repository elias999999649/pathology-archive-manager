<% content_for :page_title, "Audit Logs" %>
<div class="mb-6"><p class="text-sm text-slate-600 dark:text-slate-400">Append-only record of important archive operations.</p></div>

<%= form_with url: audit_logs_path, method: :get, local: true, class: "ui-card mb-6 p-4" do |form| %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
    <%= form.search_field :q, value: @filters["q"], placeholder: "Search logs...", class: "ui-input xl:col-span-2" %>
    <%= form.collection_select :user_id, @users, :id, :email, { include_blank: "All users", selected: @filters["user_id"] }, class: "rounded-lg border-slate-300 text-sm dark:border-slate-700 dark:bg-slate-950" %>
    <%= form.select :event_type, AuditLog::EVENT_TYPES.map { |event| [event.humanize, event] }, { include_blank: "All event types", selected: @filters["event_type"] }, class: "rounded-lg border-slate-300 text-sm dark:border-slate-700 dark:bg-slate-950" %>
    <%= form.select :resource, @resource_types.map { |type| [type, type] }, { include_blank: "All resources", selected: @filters["resource"] }, class: "rounded-lg border-slate-300 text-sm dark:border-slate-700 dark:bg-slate-950" %>
    <%= form.search_field :slide_id, value: @filters["slide_id"], placeholder: "Slide ID or UID", class: "rounded-lg border-slate-300 text-sm dark:border-slate-700 dark:bg-slate-950" %>
    <%= form.date_field :date, value: @filters["date"], class: "rounded-lg border-slate-300 text-sm dark:border-slate-700 dark:bg-slate-950" %>
  </div>
  <div class="mt-3 flex justify-end"><%= form.submit "Apply filters", class: "ui-btn ui-btn-primary" %></div>
<% end %>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <% if @audit_logs.empty? %><div class="p-10 text-center text-sm text-slate-500 dark:text-slate-400">No audit events match these filters.</div><% else %>
    <div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-950"><tr><th class="px-5 py-3">Event</th><th class="px-5 py-3">Who</th><th class="px-5 py-3">Resource</th><th class="px-5 py-3">Why</th><th class="px-5 py-3">When</th><th class="px-5 py-3"></th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800"><% @audit_logs.each do |log| %><tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50"><td class="px-5 py-4 font-medium"><%= log.event_type.humanize %></td><td class="px-5 py-4"><%= log.actor&.email || "System" %></td><td class="px-5 py-4 text-slate-500"><%= log.auditable_type ? "#{log.auditable_type} · #{log.auditable_id}" : "—" %></td><td class="max-w-xs px-5 py-4 text-slate-500"><%= log.metadata["reason"] || "—" %></td><td class="whitespace-nowrap px-5 py-4 text-slate-500"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td><td class="px-5 py-4 text-right"><%= link_to "View", audit_log_path(log), class: "font-medium text-indigo-600 hover:underline dark:text-indigo-400" %></td></tr><% end %></tbody></table></div>
  <% end %>
</div>
<div class="mt-4 flex items-center justify-between text-sm"><%= @page > 1 ? link_to("Previous", audit_logs_path(@filters.merge(page: @page - 1)), class: "font-medium text-indigo-600 hover:underline") : content_tag(:span, "Previous", class: "text-slate-400") %><span class="text-slate-500">Page <%= @page %></span><%= @has_next ? link_to("Next", audit_logs_path(@filters.merge(page: @page + 1)), class: "font-medium text-indigo-600 hover:underline") : content_tag(:span, "Next", class: "text-slate-400") %></div>
