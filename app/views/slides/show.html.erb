<% content_for :page_title, "Slide details" %>
<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
  <div><%= link_to "← Back to slides", slides_path, class: "text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400" %><h2 class="mt-3 text-2xl font-semibold"><%= @slide.slide_uid %></h2></div>
  <div class="flex flex-wrap items-center gap-2"><span class="<%= badge_classes(:status, @slide.status) %>"><%= human_enum(@slide.status) %></span><span class="<%= badge_classes(:decision, @slide.decision) %>"><%= human_enum(@slide.decision) %></span><% if @slide.status == "under_review" %><%= link_to "Open review", review_path(@slide), class: "ui-btn ui-btn-primary" %><% end %></div>
</div>
<nav aria-label="Slide workflow" class="ui-card mb-6 overflow-x-auto p-3"><ol class="flex min-w-max items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400"><% [["1", "Search / identify"], ["2", "Decision", @slide.decision.humanize], ["3", "Rule explanation"], ["4", "Retention / archive"]].each_with_index do |step, index| %><li class="flex items-center gap-2"><span class="flex h-6 w-6 items-center justify-center rounded-full <%= index < 2 ? 'bg-indigo-600 text-white' : 'bg-slate-100 dark:bg-slate-800' %>"><%= step[0] %></span><span><%= step[1] %><%= " · #{step[2]}" if step[2] %></span><%= content_tag(:span, "→", class: "mx-1 text-slate-300 dark:text-slate-600") unless index == 3 %></li><% end %></ol></nav>
<% if @latest_evaluation %>
  <section class="ui-card mb-6 border-indigo-200 bg-indigo-50/60 p-6 dark:border-indigo-900 dark:bg-indigo-950/30">
    <div class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-start"><div><p class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Automatic decision explanation</p><h3 class="mt-1 text-lg font-semibold"><%= @latest_evaluation.final_decision.humanize %></h3></div><span class="text-sm text-slate-600 dark:text-slate-300"><%= @latest_evaluation.evaluated_at.to_fs(:long) %></span></div>
    <dl class="grid gap-4 sm:grid-cols-3"><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Winning rule</dt><dd class="mt-1 text-sm"><%= @latest_evaluation.winning_rule&.name || "No rule matched" %></dd></div><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Matched rules</dt><dd class="mt-1 text-sm"><%= @latest_evaluation.matched_rule_ids.length %></dd></div><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Reason</dt><dd class="mt-1 text-sm"><%= @latest_evaluation.reason %></dd></div></dl>
    <% matched_rules = @latest_evaluation.details["matched_rules"] || [] %>
    <% if matched_rules.any? %><div class="mt-5 space-y-3"><h4 class="text-sm font-semibold">Matched rule conditions</h4><% matched_rules.each do |matched_rule| %><div class="rounded-lg border border-indigo-100 bg-white p-3 text-sm dark:border-indigo-900 dark:bg-slate-900"><div class="font-medium"><%= matched_rule["name"] %> <span class="text-xs text-slate-500">Priority <%= matched_rule["priority"] %></span></div><% Array(matched_rule["conditions"]).each do |group| %><div class="mt-2 space-y-1 text-xs text-slate-600 dark:text-slate-400"><% Array(group["conditions"]).each do |condition| %><div><%= condition["reason"] %> · actual: <%= condition["actual"].is_a?(Hash) || condition["actual"].is_a?(Array) ? condition["actual"].to_json : condition["actual"] %></div><% end %></div><% end %></div><% end %></div><% end %>
  </section>
<% end %>
<div class="grid gap-6 lg:grid-cols-2">
  <section class="ui-card p-6">
    <h3 class="mb-5 font-semibold">Slide information</h3>
    <dl class="grid gap-4 sm:grid-cols-2">
      <% [["Case ID", @slide.case_id], ["Patient ID", @slide.patient_id], ["Barcode", @slide.barcode], ["Slide type", @slide.slide_type], ["Stain", @slide.stain], ["Scanner", @slide.scanner], ["Hospital", @slide.hospital], ["Department", @slide.department], ["Diagnosis", @slide.diagnosis], ["Received", @slide.received_at&.to_fs(:long)], ["Acquired", @slide.acquisition_date&.to_fs(:long)], ["File size", @slide.file_size ? number_to_human_size(@slide.file_size) : nil]].each do |label, value| %>
        <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= label %></dt><dd class="mt-1 break-words text-sm"><%= value.presence || "—" %></dd></div>
      <% end %>
    </dl>
  </section>
  <section class="ui-card p-6">
    <h3 class="mb-5 font-semibold">Archive information</h3>
    <dl class="space-y-4">
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Decision reason</dt><dd class="mt-1 text-sm"><%= @slide.decision_reason.presence || "—" %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Retention</dt><dd class="mt-1 text-sm"><%= retention_label(@slide) %> · <%= @slide.retention_status.humanize %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Retention period</dt><dd class="mt-1 text-sm"><%= @slide.retention_duration.present? ? "#{@slide.retention_duration['value'] || 'Forever'} #{@slide.retention_duration['unit']}" : "—" %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Retention rule</dt><dd class="mt-1 text-sm"><%= @slide.retention_rule&.name || "Manual / policy-based" %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Storage path</dt><dd class="mt-1 break-all text-sm"><%= @slide.storage_path.presence || "—" %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Source API</dt><dd class="mt-1 text-sm"><%= @slide.source_api_connection&.name || "Manual / unknown" %></dd></div>
      <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tags</dt><dd class="mt-1 text-sm"><%= @slide.tags.presence&.join(", ") || "—" %></dd></div>
    </dl>
  </section>
</div>
<section class="ui-card mt-6 p-6"><h3 class="mb-3 font-semibold">External metadata</h3><pre class="overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-200"><%= JSON.pretty_generate(@slide.metadata) %></pre></section>
