<div class="mb-2 grid gap-2 sm:grid-cols-12" data-action-row><select name="archive_rule[actions][<%= action_index %>][type]" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-4 dark:border-slate-700 dark:bg-slate-950"><% ArchiveRule::ACTIONS.each do |type| %><option value="<%= type %>" <%= 'selected' if action['type'].to_s == type %>><%= type.humanize %></option><% end %></select><input name="archive_rule[actions][<%= action_index %>][days]" value="<%= action['days'] %>" placeholder="Retention days" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-3 dark:border-slate-700 dark:bg-slate-950"><input name="archive_rule[actions][<%= action_index %>][tag]" value="<%= action['tag'] %>" placeholder="Tag to add" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-3 dark:border-slate-700 dark:bg-slate-950"><input name="archive_rule[actions][<%= action_index %>][channel]" value="<%= action['channel'] %>" placeholder="Notification channel" class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm sm:col-span-1 dark:border-slate-700 dark:bg-slate-950"><button type="button" data-action="rule-builder#removeAction" class="rounded-lg px-2 text-sm font-medium text-rose-600 sm:col-span-1" aria-label="Remove action">Remove</button></div>
