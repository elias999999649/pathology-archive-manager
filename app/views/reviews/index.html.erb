<% content_for :page_title, "Reviews" %>
<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"><div><p class="text-sm text-slate-600 dark:text-slate-400">Slides awaiting a reviewer decision. Open a slide to understand the rule explanation before acting.</p></div><div class="text-sm font-medium text-slate-500 dark:text-slate-400"><%= number_with_delimiter(@total_count) %> pending</div></div>
<%= form_with url: reviews_path, method: :get, local: true, class: "ui-card mb-6 p-4" do |form| %><%= form.search_field :q, value: params[:q], placeholder: "Search slide ID, case, patient, barcode, scanner, hospital, tags…", class: "ui-input w-full" %><%= form.submit "Search reviews", data: { turbo_submits_with: "Searching…" }, class: "ui-btn ui-btn-primary mt-3" %><% end %>
<% if @slides.any? %>
  <div class="ui-card overflow-hidden"><div class="overflow-x-auto"><table class="ui-table min-w-full text-left text-sm"><thead><tr><th>Slide ID</th><th>Case ID</th><th>Slide type</th><th>Hospital</th><th>Decision</th><th>Received</th><th>Action</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800"><% @slides.each do |slide| %><tr><td class="font-medium"><%= link_to slide.slide_uid, review_path(slide), class: "text-indigo-600 hover:underline dark:text-indigo-400" %></td><td><%= slide.case_id %></td><td><%= slide.slide_type.presence || "—" %></td><td><%= slide.hospital.presence || "—" %></td><td><span class="<%= badge_classes(:decision, slide.decision) %>"><%= slide.decision.humanize %></span></td><td class="whitespace-nowrap text-slate-600 dark:text-slate-400"><%= slide.received_at.to_fs(:short) %></td><td><%= link_to "Review", review_path(slide), class: "font-medium text-indigo-600 hover:underline dark:text-indigo-400" %></td></tr><% end %></tbody></table></div></div>
<% else %><div class="ui-empty"><h2 class="font-semibold">No slides require review</h2><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">The review queue is clear.</p></div><% end %>
<% if @total_pages > 1 %><nav class="mt-6 flex items-center justify-between text-sm"><span class="text-slate-500">Page <%= @page %> of <%= @total_pages %></span><div class="flex gap-2"><%= link_to "Previous", reviews_path(@filters.merge(page: @page - 1)), class: "rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-700" %><%= link_to "Next", reviews_path(@filters.merge(page: @page + 1)), class: "rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-700" %></div></nav><% end %>
