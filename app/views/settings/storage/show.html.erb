<% content_for :page_title, "Storage" %>
<div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-sm text-slate-600 dark:text-slate-400">Monitor capacity, growth, and logical slide storage usage.</p></div><%= button_to "Refresh status", settings_storage_refresh_path, method: :post, data: { turbo_submits_with: "Refreshing…" }, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %></div>
<% if @snapshot %>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><% [["Provider", @snapshot.provider_name], ["Total capacity", storage_value(@snapshot.total_bytes)], ["Used capacity", storage_value(@snapshot.used_bytes)], ["Free capacity", storage_value(@snapshot.free_bytes)]].each do |label, value| %><article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500 dark:text-slate-400"><%= label %></p><p class="mt-3 text-xl font-semibold"><%= value %></p></article><% end %></div>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-semibold">Usage</h2><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Warnings at 80%, 90%, and 95%.</p></div><span class="<%= storage_status_classes(@snapshot) %>"><%= storage_status_label(@snapshot) %></span></div><div class="mt-5 h-4 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800"><div class="h-full rounded-full <%= storage_progress_classes(@snapshot) %>" style="width: <%= @snapshot.usage_percentage || 0 %>%"></div></div><div class="mt-2 flex justify-between text-sm text-slate-500 dark:text-slate-400"><span><%= @snapshot.usage_percentage ? "#{@snapshot.usage_percentage}% used" : "Usage unavailable" %></span><span>Last checked <%= @snapshot.checked_at.to_fs(:short) %></span></div><% if @snapshot.error.present? %><p role="alert" class="mt-4 rounded-lg bg-rose-50 p-3 text-sm text-rose-700 dark:bg-rose-950/40 dark:text-rose-300"><%= @snapshot.error %></p><% end %></section>
  <div class="mt-6 grid gap-4 sm:grid-cols-3"><% [["Stored slides", number_with_delimiter(@snapshot.slide_count)], ["Growth", @snapshot.growth_bytes_per_day ? "#{storage_value(@snapshot.growth_bytes_per_day)} / day" : "—"], ["Estimated remaining", @snapshot.estimated_remaining_days ? "#{@snapshot.estimated_remaining_days} days" : "—"]].each do |label, value| %><article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500 dark:text-slate-400"><%= label %></p><p class="mt-3 text-lg font-semibold"><%= value %></p></article><% end %></div>
  <div class="mt-6 grid gap-6 lg:grid-cols-2"><%= render "breakdown", title: "Storage by slide type", values: @snapshot.by_slide_type %><%= render "breakdown", title: "Storage by hospital", values: @snapshot.by_hospital %></div>
<% else %><div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900"><h2 class="font-semibold">No storage check yet</h2><p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Refresh storage status to create the first monitoring snapshot.</p></div><% end %>
