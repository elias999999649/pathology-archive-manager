<section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"><h2 class="mb-4 font-semibold"><%= title %></h2><% if values.present? %><div class="space-y-3"><% values.sort_by { |_name, bytes| -bytes.to_i }.each do |name, bytes| %><div class="flex items-center justify-between gap-4 text-sm"><span class="truncate"><%= name %></span><span class="whitespace-nowrap font-medium"><%= storage_value(bytes) %></span></div><% end %></div><% else %><p class="text-sm text-slate-500 dark:text-slate-400">No storage breakdown available.</p><% end %></section>
